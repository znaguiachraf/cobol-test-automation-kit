{
  "project_name": "PREMCALC demo",
  "compiler": {
    "adapter": "gnucobol",
    "executable": "cobc",
    "args": [
      "-x",
      "-free",
      "-Wall"
    ],
    "timeout_seconds": 60
  },
  "paths": {
    "source_dir": "samples/src",
    "source_file": "PREMCALC.cbl",
    "build_dir": "build",
    "tests_file": "samples/tests/premcalc_tests.json",
    "report_dir": "reports"
  },
  "run": {
    "default_test_timeout_seconds": 5,
    "max_output_bytes": 65536
  }
}
